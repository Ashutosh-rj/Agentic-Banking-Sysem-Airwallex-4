# ==========================================
# Root .gitignore - Agentic Banking Platform
# ==========================================

# Environment variables & secrets
.env
.env.*
*.env
!.env.example
!.env.*.example

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Docker local overrides
docker-compose.override.yml
*.docker.local

# Database & SQLite files
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
kaizen.db
kaizen.db*

# ==========================================
# Python (Backend)
# ==========================================
backend/__pycache__/
backend/*/__pycache__/
backend/**/__pycache__/
__pycache__/
*.py[cod]
*$py.class
*.so

# Python distribution / packaging
*.egg
*.egg-info/
backend/*.egg-info/
dist/
build/
eggs/
.eggs/
develop-eggs/
downloads/
parts/
sdist/
var/
wheels/
share/python-wheels/

# Python Virtual Environments
backend/.venv/
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Code Coverage
backend/.pytest_cache/
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.tox/

# ==========================================
# Node.js / TypeScript (Frontend)
# ==========================================
frontend/node_modules/
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.eslintcache
frontend/.stylelintcache
*.tsbuildinfo
.turbo/
.npm/

# Testing (Frontend)
frontend/coverage/
.nyc_output/
